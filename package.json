{
  "name": "botion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.js",
    "dev": "concurrently \"pnpm dev:worker\" \"pnpm dev:client\"",
    "dev:worker": "wrangler dev --port 8787 --local",
    "dev:client": "pnpm --filter client dev",
    "dev:local": "concurrently \"pnpm dev:worker:local\" \"pnpm dev:client:local\"",
    "dev:worker:local": "wrangler dev --port 8787 --local --persist-to=.local/state",
    "dev:client:local": "VITE_LOCAL_MODE=true pnpm --filter client dev",
    "dev:tauri": "pnpm --filter client tauri dev",
    "build:client": "pnpm --filter client build",
    "build:tauri": "pnpm --filter client tauri build",
    "typecheck": "tsc --noEmit && pnpm --filter client typecheck",
    "deploy:worker": "node scripts/deploy.js",
    "deploy:client": "wrangler pages deploy client/dist --project-name=botion-web",
    "gen:jwt": "node scripts/gen-jwt-secret.js",
    "db:migrate": "wrangler d1 migrations apply botion-db",
    "db:migrate:local": "wrangler d1 migrations apply botion-db --local",
    "db:sync": "node scripts/db-sync.js",
    "setup": "node scripts/setup.js",
    "test": "node tests/run.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "concurrently": "^8.2.0",
    "sharp": "^0.35.4",
    "typescript": "^5.4.0",
    "wrangler": "^4.136.1"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "jose": "^5.4.0",
    "yjs": "^13.6.0",
    "zod": "^3.23.0"
  },
  "packageManager": "pnpm@9.0.0"
}
