{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Botion",
  "version": "0.1.0",
  "identifier": "dev.botion.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm tauri:prebuild",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Botion",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RUM4NzUzRkY4QzlGRkUKUldUK240ei9VNGZzS0NhdTVhVS85TEFsOFlxN3ZjSjBnSkRmWmhuRjVZSlNaV1k0Ujlyc3NIWEkK",
      "endpoints": [
        "https://github.com/truehannan/botion/releases/latest/download/latest.json"
      ]
    }
  }
}
