# Example local dev / build variables for Botion's Worker.
# Copy to `.dev.vars` (git-ignored) and fill in real values, OR set the same
# names as environment variables in Cloudflare Workers Builds
# (Settings → Build → Environment variables).

# ── D1 database id ─────────────────────────────────────────────
# wrangler.toml ships with  database_id = ""  (empty). scripts/deploy.js fills
# it in from --d1 <id> OR this D1_DATABASE_ID env var, just before deploy.
#   • Leave BLANK/unset → wrangler >=4.45.0 auto-provisions the DB on
#     `wrangler deploy` and links it for you (no id needed).
#   • Set the real id (from `npx wrangler d1 list`) → binds that exact database.
# Get it once with:  npx wrangler d1 create botion-db   (or: d1 list)
D1_DATABASE_ID=

# ── Auth secret (required) ─────────────────────────────────────
# HS256 signing key for JWTs. In production set it as a runtime secret instead:
#   npx wrangler secret put JWT_SECRET
JWT_SECRET=change-me-in-local-dev
